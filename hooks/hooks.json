{
  "description": "kerjaan2 — tell a starting, resumed or just-summarized session what the board has in flight, and keep a worker from ending before its ticket is handed over",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/k2\" hook session-start", "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "kerjaan2:worker|worker",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/k2\" hook subagent-stop", "timeout": 10 }
        ]
      }
    ]
  }
}
